# ===========================================================
# SECRETS RUNTIME — injectés UNIQUEMENT sur le serveur de prod. Copier ce gabarit vers .env.secrets et
# remplir les valeurs. .env.secrets est gitignoré (jamais commité,
# jamais dans les images Docker).
# ===========================================================
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Clé partagée API <-> serveur de jeu : DOIT être identique dans
# beehex-api et beehex-websocket.
GAMESERVER_KEY=