# ===========================================================
# VARIABLES RUNTIME (non secrètes) — copier dans .env (gitignoré).
# Voir .env.secrets.example pour les secrets.
# ===========================================================
POSTGRES_DB=
POSTGRES_USER=

COOKIE_DOMAIN=
CORS_ORIGIN=
API_PUBLIC_URL=

# ===========================================================
# BUILD-TIME — URLs publiques du frontend (injectées en build-args
# par le workflow GitHub, définies aussi dans les Variables de
# l'environnement "production").
# ===========================================================
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEBSOCKET_URL=